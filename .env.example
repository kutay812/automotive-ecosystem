# ==========================================
# VisionArc Environment Configuration Template
# ==========================================

# Port & Node Ortamı
PORT=1337
NODE_ENV=production

# Veritabanı (PostgreSQL)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=example_db
DATABASE_USER=example
DATABASE_PASSWORD=example_pwd

# Önbellek (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=example_redis

# Güvenlik & JWT (Canlı ortamda MUTLAKA değiştirin!)
JWT_SECRET=degistirin-guclu-kullanici-jwt-anahtari-2026
ADMIN_JWT_SECRET=degistirin-guclu-admin-jwt-anahtari-2026

# Ödeme Sağlayıcı Yapılandırması (dummy | iyzico | stripe)
PAYMENT_PROVIDER=dummy
PAYMENT_WEBHOOK_SECRET=degistirin-guclu-webhook-anahtari-2026

# Iyzico API (İleride devreye alınacaksa)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Stripe API (İleride devreye alınacaksa)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL Yapılandırması
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://backend:1337
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# E-posta (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=ethereal_user
SMTP_PASS=ethereal_pass

# İlk Süper Yönetici Bilgileri (create-superadmin)
SA_EMAIL=admin@example.com
SA_PASSWORD=admin123456
SA_FIRST=Admin
SA_LAST=User

# Dosya Yükleme Sınırı (MB)
MAX_UPLOAD_MB=200

