{
    "kind": "collectionType",
    "collectionName": "cars",
    "info": {
        "singularName": "car",
        "pluralName": "cars",
        "displayName": "Car",
        "description": "Rent a car entity"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "brand": {
            "type": "string"
        },
        "model": {
            "type": "string"
        },
        "year": {
            "type": "biginteger"
        },
        "pricePerDay": {
            "type": "decimal"
        },
        "description": {
            "type": "text"
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ]
        },
        "isAvailable": {
            "type": "boolean",
            "default": true
        },
        "transmission": {
            "type": "enumeration",
            "default": "Otomatik",
            "enum": [
                "Otomatik",
                "Manuel"
            ]
        },
        "fuelType": {
            "type": "enumeration",
            "default": "Benzin",
            "enum": [
                "Benzin",
                "Dizel",
                "Elektrik",
                "Hibrit"
            ]
        },
        "passengerCount": {
            "type": "integer",
            "default": 5
        },
        "luggageCount": {
            "type": "integer",
            "default": 2
        },
        "availableUntil": {
            "type": "date"
        }
    }
}
