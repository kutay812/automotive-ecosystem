# VisionArc Backend Environment Variables
# Lütfen kök dizindeki .env.example dosyasını referans alınız.

PORT=1337
NODE_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=example_db
DATABASE_USERNAME=example
DATABASE_PASSWORD=example_pwd

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=example_redis

JWT_SECRET=degistirin-guclu-kullanici-jwt-anahtari-2026
ADMIN_JWT_SECRET=degistirin-guclu-admin-jwt-anahtari-2026

PAYMENT_PROVIDER=dummy
PAYMENT_WEBHOOK_SECRET=degistirin-guclu-webhook-anahtari-2026

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000

MAX_UPLOAD_MB=200
